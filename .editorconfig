root = true

# All files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Go files
[*.go]
indent_style = tab
indent_size = 4

# Screen captures: frames of the program's own render, trailing spaces included.
# Reformatting a file makes TestCaptureFiles fail.
[plan/testing/manual/captures/**]
trim_trailing_whitespace = false
